# Copy to .env and fill in. Never commit .env.

# Display name of the app.
BRAND_NAME=Tradepit

# SQLite file. Created on first run. Keep it out of git: it holds encrypted wallet keys.
DATABASE_PATH=./data/app.db

# 32-byte hex key that encrypts embedded wallet private keys at rest.
# Generate one with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=replace-with-64-hex-characters

# Ethereum mainnet JSON-RPC endpoint used to read deposit balances.
RPC_URL=https://ethereum-rpc.publicnode.com

# Public URL of this app.
APP_URL=http://localhost:3000
