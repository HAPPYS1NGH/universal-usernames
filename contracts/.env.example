# Copy to contracts/.env. Foundry loads it automatically for forge script.
# The deployer key is NOT here: it lives in a Foundry keystore (`cast wallet import deployer --interactive`).

# Where the gateway runs. Keep the {sender} and {data} placeholders.
GATEWAY_URL=https://gateway.example.com/{sender}/{data}.json

# Address of the gateway's SIGNER_PRIVATE_KEY (`cast wallet address <key>`).
SIGNER_ADDRESS=0x0000000000000000000000000000000000000000

MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional: only needed for `--verify`.
ETHERSCAN_API_KEY=your-etherscan-api-key
