# Key that signs gateway answers. Create a dedicated one with `cast wallet new`.
# This is NOT the key that deploys or owns the resolver contract.
SIGNER_PRIVATE_KEY=replace-with-the-private-key-from-cast-wallet-new

# The ENS name you own. The gateway answers for <username>.<ENS_PARENT_NAME>.
ENS_PARENT_NAME=tradepit.eth

# Base URL of the app. The gateway calls GET {APP_API_URL}/api/ens/{username}.
APP_API_URL=http://localhost:3000

PORT=8080

# How long a signed answer stays valid, in seconds.
RESPONSE_TTL_SECONDS=300
